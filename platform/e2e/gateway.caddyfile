# The homelab gateway (ADR-PLAT-004): every request to an app is asked about at the accounts service
# first, by the sign-in check in signed-in.caddyfile, and every page of an app gets the App
# switcher, from switcher.caddyfile (both in platform/gateway).
{
	# A self-signed CA, since *.home.test has no public certificate. A real install uses its own.
	local_certs
	skip_install_trust
}

# The accounts site gets the App switcher too, for people managing their account.
accounts.{$HOMELAB_DOMAIN} {
	import /etc/caddy/switcher.caddyfile
	reverse_proxy accounts:3000
}

home.{$HOMELAB_DOMAIN} {
	route {
		import /etc/caddy/signed-in.caddyfile
		import /etc/caddy/switcher.caddyfile
		reverse_proxy {$HOME_UPSTREAM}
	}
}

notes.{$HOMELAB_DOMAIN} {
	route {
		import /etc/caddy/signed-in.caddyfile
		import /etc/caddy/switcher.caddyfile
		reverse_proxy notes:3000
	}
}

encyclopedia.{$HOMELAB_DOMAIN} {
	route {
		import /etc/caddy/signed-in.caddyfile
		import /etc/caddy/switcher.caddyfile
		root * /srv/encyclopedia
		try_files {path} /index.html
		file_server
	}
}

# A stand-in for a bundled app such as Vaultwarden: its manifest doesn't say it opens offline, and
# its page has a strict security policy, as Vaultwarden's does.
vault.{$HOMELAB_DOMAIN} {
	route {
		import /etc/caddy/signed-in.caddyfile
		import /etc/caddy/switcher.caddyfile
		header /manifest.webmanifest Content-Type application/manifest+json
		respond /manifest.webmanifest `{"name": "Vault", "icons": []}`
		header Content-Type "text/html; charset=utf-8"
		header Content-Security-Policy "default-src 'self'; style-src 'self'; script-src 'self'"
		respond `<!doctype html><html><head><title>Vault</title></head><body><h1>Vault</h1></body></html>`
	}
}
