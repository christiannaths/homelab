{
  "name": "homelab",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26",
      "onFail": "error"
    }
  },
  "workspaces": [
    "apps/*/*",
    "packages/*",
    "spikes/*/*",
    "tools"
  ],
  "scripts": {
    "build": "nx run-many -t build --exclude=tag:spike",
    "typecheck": "nx run-many -t typecheck --exclude=tag:spike",
    "test": "nx run-many -t test --exclude=tag:spike",
    "test:e2e": "nx run-many -t e2e --exclude=tag:spike",
    "boundaries": "node tools/check-boundaries.ts",
    "check": "npm run boundaries && nx run-many -t typecheck test --exclude=tag:spike"
  },
  "devDependencies": {
    "nx": "^23.3.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "overrides": {
    "undici": "7.30.1"
  }
}
