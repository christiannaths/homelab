{
  "config": {
    "default": true,
    "extends": "markdownlint/style/prettier",
    // Prettier owns table formatting.
    "table-column-style": false,
  },
  "gitignore": true,
  // Vendored: Matt Pocock's skills, managed by `npx skills` (the adr skill is this repo's own).
  // CLAUDE.md is a single import of AGENTS.md.
  "ignores": [".agents/skills/!(adr)/**", ".claude/skills/**", "CLAUDE.md"],
}
