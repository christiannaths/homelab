{
  "name": "@homelab/notes-server",
  "private": true,
  "type": "module",
  "nx": {
    "name": "notes-server",
    "tags": [
      "scope:notes",
      "platform:node"
    ],
    "implicitDependencies": [
      "notes-web"
    ]
  },
  "scripts": {
    "dev": "tsx watch --no-experimental-webstorage src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --no-experimental-webstorage dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hocuspocus/server": "^4.7.1",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2"
  }
}
