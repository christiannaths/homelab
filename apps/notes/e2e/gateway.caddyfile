# The homelab gateway (ADR-PLAT-004): every request to Notes is asked about at VoidAuth first, by
# the sign-in check in packages/gateway/signed-in.caddyfile.
{
	# A self-signed CA, since *.home.test has no public certificate. A real install uses its own.
	local_certs
	skip_install_trust
}

accounts.{$HOMELAB_DOMAIN} {
	reverse_proxy voidauth:3000
}

notes.{$HOMELAB_DOMAIN} {
	route {
		import /etc/caddy/signed-in.caddyfile
		reverse_proxy {$NOTES_UPSTREAM}
	}
}
