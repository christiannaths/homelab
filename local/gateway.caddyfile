# The homelab gateway (ADR-PLAT-004): every request to an app is asked about at VoidAuth first.
# VoidAuth answers from its session cookie on the parent domain: 200 with Remote-* headers, a
# redirect to its sign-in page, or a redirect to its "forbidden" page when the person's groups
# don't include the app's.
{
	# A self-signed CA, since *.home.test has no public certificate. A real install uses its own.
	local_certs
	skip_install_trust
}

# Goes first in an app site's route block, before whatever serves the app.
(signed-in) {
	# forward_auth only overwrites the headers VoidAuth sends. It sends no Remote-Name or
	# Remote-Email for a person without one, so the browser's own would reach the app.
	request_header -Remote-User
	request_header -Remote-Groups
	request_header -Remote-Name
	request_header -Remote-Email
	forward_auth voidauth:3000 {
		uri /api/authz/forward-auth
		copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
	}
}

auth.{$HOMELAB_DOMAIN} {
	reverse_proxy voidauth:3000
}

notes.{$HOMELAB_DOMAIN} {
	route {
		import signed-in
		reverse_proxy notes:3000
	}
}

# The Encyclopedia's static build, with its own service worker. Unknown paths get index.html.
encyclopedia.{$HOMELAB_DOMAIN} {
	route {
		import signed-in
		root * /srv/encyclopedia
		try_files {path} /index.html
		file_server
	}
}
