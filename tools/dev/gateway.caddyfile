# The homelab gateway (ADR-PLAT-004), built from platform/gateway: every request to an app is asked
# about at the accounts service first, by the sign-in check in signed-in.caddyfile, and every page
# of an app gets the App switcher, from switcher.caddyfile.
{
	# A self-signed CA, since *.homelab.localhost has no public certificate. A real install uses its own.
	local_certs
	skip_install_trust
}

# The accounts site gets the App switcher too, for people managing their account.
accounts.{$SITE_DOMAIN} {
	import /etc/caddy/switcher.caddyfile
	reverse_proxy accounts:3000
}

home.{$SITE_DOMAIN} {
	route {
		import /etc/caddy/signed-in.caddyfile
		import /etc/caddy/switcher.caddyfile
		reverse_proxy home:3000
	}
}

notes.{$SITE_DOMAIN} {
	route {
		import /etc/caddy/signed-in.caddyfile
		import /etc/caddy/switcher.caddyfile
		reverse_proxy notes:3000
	}
}

# The Encyclopedia's static build, with its own service worker. Unknown paths get index.html.
encyclopedia.{$SITE_DOMAIN} {
	route {
		import /etc/caddy/signed-in.caddyfile
		import /etc/caddy/switcher.caddyfile
		root * /srv/encyclopedia
		try_files {path} /index.html
		file_server
	}
}
