# The homelab gateway (ADR-PLAT-004): every request to an app is asked about at VoidAuth first, by
# the sign-in check in packages/gateway/signed-in.caddyfile.
{
	# A self-signed CA, since *.homelab.localhost has no public certificate. A real install uses its own.
	local_certs
	skip_install_trust
}

accounts.{$HOMELAB_DOMAIN} {
	reverse_proxy voidauth:3000
}

home.{$HOMELAB_DOMAIN} {
	route {
		import /etc/caddy/signed-in.caddyfile
		reverse_proxy home:3000
	}
}

notes.{$HOMELAB_DOMAIN} {
	route {
		import /etc/caddy/signed-in.caddyfile
		reverse_proxy notes:3000
	}
}

# The Encyclopedia's static build, with its own service worker. Unknown paths get index.html.
encyclopedia.{$HOMELAB_DOMAIN} {
	route {
		import /etc/caddy/signed-in.caddyfile
		root * /srv/encyclopedia
		try_files {path} /index.html
		file_server
	}
}
